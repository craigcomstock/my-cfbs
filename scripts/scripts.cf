bundle agent scripts
{
  vars:
    windows::
      "script_paths" slist => findfiles("${this.promise_dirname}${const.dirsep}*.{ps1,bat}");
      "scripts[${script_paths}]" string => string_replace("${script_paths}", "${source}", "${dest}");
  files:
    windows::
      "${scripts[${script_paths}]}"
        copy_from => local_cp(${script_paths});
}
