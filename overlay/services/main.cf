###############################################################################
#
# bundle agent mpf_main
#  - User/Site policy entry
#
###############################################################################

bundle agent mpf_main
# User Defined Service Catalogue
{
  packages:
    termux::
      "com.termux"
        policy => "present",
        options => {
          "github_organization=termux",
          "github_project=termux-app",
          "github_token_secret_path=${sys.masterdir}/services/cfbs/secrets/craigcomstock-android-application-module-github-token.cfsecret"
        },
        version => "v0.118.2",
        package_module => android_application;
}
