# maybe some options?
# https://docs.docker.com/desktop/wsl/
# To check the WSL mode, run:
# wsl.exe -l -v
#To upgrade the Linux distro to v2, run:
# wsl.exe --set-version (distro name) 2
#To set v2 as the default version for future installations, run:
# wsl.exe --set-default-version 2
bundle agent wsl_installed
{
  classes:
    windows::
# wsl installed but no kernel might be $LastExitCode = -444, maybe
# https://learn.microsoft.com/en-us/powershell/module/dism/get-windowsoptionalfeature?view=windowsserver2022-ps
      "wsl_installed" expression => returnszero("Get-WindowsOptionalFeature -Online -FeatureName Microsoft-Windows-Subsystem-Linux | out-null", "powershell");

  commands:
    windows.!wsl_installed::
# https://learn.microsoft.com/en-us/powershell/module/dism/enable-windowsoptionalfeature?view=windowsserver2022-ps -NoRestart option to avoid reboot prompt
      "Enable-WindowsOptionalFeature -Online -FeatureName Microsoft-Windows-Subsystem-Linux -NoRestart | out-null"
        contain => powershell,
        classes => if_repaired("wsl_install_needs_reboot");

    windows.wsl_install_needs_reboot::
      "Restart-Computer"
        contain => powershell;
}
