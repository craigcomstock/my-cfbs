{
  "name": "Example project",
  "description": "Example description",
  "type": "policy-set",
  "git": true,
  "build": [
    {
      "name": "package-module-android-application",
      "description": "Android application package module.",
      "url": "https://github.com/craigcomstock/cfengine-android-helpers",
"commit": "307a909e0d3d59f9bd0661e65fc4c6ec4cd8c785",
      "subdirectory": "management/package-module-android-application",
      "added_by": "cfbs add",
      "steps": [
        "directory ./ services/cfbs/modules/package-module-android-application/",
        "copy ./android_application modules/packages/",
        "policy_files services/cfbs/modules/package-module-android-application/package-module-android-application.cf",
        "json ./enable-android-application-inventory.json def.json"
      ]
    },
    {
      "name": "masterfiles",
      "description": "Official CFEngine Masterfiles Policy Framework (MPF)",
      "url": "https://github.com/cfengine/masterfiles",
      "commit": "d38e3a331ee28604b0225dedd8c089aded95e8c1",
      "added_by": "cfbs add",
      "steps": ["run ./prepare.sh -y", "copy ./ ./"]
    },
    {
      "name": "allow-hosts",
      "description": "Allows specific hosts (by IP / subnet) to connect and fetch policy.",
      "tags": ["management", "security", "experimental"],
      "repo": "https://github.com/olehermanse/cfengine-allow-hosts",
      "by": "https://github.com/olehermanse",
      "version": "0.0.2",
      "commit": "620b4a523d82cb3b50a429b2f8d3511c7efa219c",
      "added_by": "cfbs add",
      "steps": ["input ./input.json def.json"],
      "input": [
        {
          "type": "list",
          "namespace": "default",
          "bundle": "def",
          "variable": "acl",
          "label": "Allowed hosts",
          "subtype": {
            "type": "string",
            "label": "IP / subnet",
            "question": "IP / subnet to allow"
          },
          "while": "Do you want to specify more IPs / subnets?"
        }
      ]
    },
    {
      "name": "windows-capability",
      "description": "Manage and inventory Windows Capabilities.",
      "tags": ["supported", "windows", "inventory", "management"],
      "repo": "https://github.com/cfengine/modules",
      "by": "https://github.com/craigcomstock",
      "version": "1.0.0",
      "commit": "9daca3b9e366daeeb53e872685a358c78823f29d",
      "subdirectory": "management/windows-capability",
      "added_by": "windows-openssh-server",
      "steps": [
        "directory ./ services/cfbs/windows-capability/",
        "policy_files services/cfbs/windows-capability/",
        "bundles windows_capability"
      ]
    },
    {
      "name": "windows-openssh-server",
      "description": "Optionally install Windows OpenSSH Server.",
      "tags": ["supported", "windows", "management"],
      "repo": "https://github.com/cfengine/modules",
      "by": "https://github.com/craigcomstock",
      "version": "1.1.0",
      "commit": "7c6456cef233d61d16719f1fcdc2cdbd6bc1142f",
      "subdirectory": "software/windows",
      "dependencies": ["windows-capability"],
      "added_by": "cfbs add",
      "steps": [
        "copy windows-openssh-server.cf services/cfbs/software/windows/windows-openssh-server.cf",
        "policy_files services/cfbs/software/windows/windows-openssh-server.cf",
        "bundles windows_openssh_server"
      ]
    },
    {
      "name": "inventory-windows-services",
      "description": "Inventory running Windows services.",
      "tags": ["supported", "windows", "inventory", "security"],
      "repo": "https://github.com/cfengine/modules",
      "by": "https://github.com/craigcomstock",
      "version": "0.0.1",
      "commit": "bf3b21d34d6506671fb7977443d9bfa24ea25241",
      "subdirectory": "inventory",
      "added_by": "cfbs add",
      "steps": [
        "copy inventory-windows-services.cf services/cfbs/inventory-windows-services/",
        "policy_files services/cfbs/inventory-windows-services/",
        "bundles inventory_windows_services_running"
      ]
    },
    {
      "name": "windows-optional-feature",
      "description": "Manage and inventory Windows Optional Features.",
      "tags": ["supported", "windows", "inventory", "management"],
      "repo": "https://github.com/cfengine/modules",
      "by": "https://github.com/craigcomstock",
      "version": "1.0.0",
      "commit": "9daca3b9e366daeeb53e872685a358c78823f29d",
      "subdirectory": "management/windows-optional-feature",
      "added_by": "cfbs add",
      "steps": [
        "directory ./ services/cfbs/windows-optional-feature/",
        "policy_files services/cfbs/windows-optional-feature/",
        "bundles windows_optional_feature"
      ]
    },
    {
      "name": "./windows-openssh-server.cf",
      "description": "Local policy file added using cfbs command line",
      "tags": ["local"],
      "added_by": "cfbs add",
      "steps": [
        "copy ./windows-openssh-server.cf services/cfbs/software/windows/"
      ]
    },
    {
      "name": "client-initiated-reporting",
      "description": "Enables client initiated reporting and disable pull collection.",
      "tags": ["experimental", "reporting"],
      "repo": "https://github.com/cfengine/modules",
      "by": "https://github.com/cfengine",
      "version": "0.1.1",
      "commit": "c3b7329b240cf7ad062a0a64ee8b607af2cb912a",
      "subdirectory": "reporting/client-initiated-reporting",
      "added_by": "cfbs add",
      "steps": ["json def.json def.json"]
    },
    {
      "name": "./overlay/",
      "description": "Local subdirectory added using cfbs command line",
      "tags": ["local"],
      "added_by": "cfbs add",
      "steps": ["directory ./ ./"]
    }
  ]
}
