{
  "name": "Example project",
  "description": "Example description",
  "type": "policy-set",
  "git": true,
  "build": [
    {
      "name": "autorun",
      "description": "Enables autorun functionality.",
      "tags": ["supported", "management"],
      "repo": "https://github.com/cfengine/modules",
      "by": "https://github.com/olehermanse",
      "version": "1.0.2",
      "commit": "e603b586e4028364ceea234f3b71c6e5d78b811e",
      "subdirectory": "management/autorun",
      "added_by": "cfbs add",
      "steps": ["json def.json def.json"]
    },
    {
      "name": "masterfiles",
      "description": "Official CFEngine Masterfiles Policy Framework (MPF).",
      "tags": ["supported", "base"],
      "repo": "https://github.com/cfengine/masterfiles",
      "by": "https://github.com/cfengine",
      "version": "3.18.3",
      "commit": "c92106b72ac9a9f12e412df7ecba1ea22bcb373a",
      "added_by": "cfbs add",
      "steps": [
        "run sed -i.bak 's|prefix=\"/var/cfengine/\"|prefix=\"/var/cfengine\"|g' prepare.sh",
        "run EXPLICIT_RELEASE=2 ./prepare.sh -y",
        "run grep --files-with-matches -R 3.18.3 . | xargs -n1 sed -i.bak 's/3\\.18\\.3a.*\\b/3.18.3/g'",
        "run find . -name '*.bak' | xargs rm",
        "copy ./ ./"
      ]
    }
  ]
}
