{
  "name": "Example project",
  "description": "Example description",
  "type": "policy-set",
  "git": true,
  "build": [
    {
      "name": "package-module-android-application",
      "description": "Android application package module.",
      "url": "https://github.com/craigcomstock/cfengine-android-helpers",
      "commit": "d3f2c21411f40cc8f1e75ce0d379b55f1e3ba8d0",
      "subdirectory": "management/package-module-android-application",
      "added_by": "cfbs add",
      "steps": [
        "directory ./ services/cfbs/modules/package-module-android-application/",
        "policy_files services/cfbs/modules/package-module-android-application/package-module-android-application.cf"
      ]
    },
    {
      "name": "masterfiles",
      "description": "Official CFEngine Masterfiles Policy Framework (MPF)",
      "url": "https://github.com/cfengine/masterfiles",
      "commit": "d38e3a331ee28604b0225dedd8c089aded95e8c1",
      "added_by": "cfbs add",
      "steps": ["run ./prepare.sh -y", "copy ./ ./"]
    },
    {
      "name": "allow-hosts",
      "description": "Allows specific hosts (by IP / subnet) to connect and fetch policy.",
      "tags": ["management", "security", "experimental"],
      "repo": "https://github.com/olehermanse/cfengine-allow-hosts",
      "by": "https://github.com/olehermanse",
      "version": "0.0.2",
      "commit": "620b4a523d82cb3b50a429b2f8d3511c7efa219c",
      "added_by": "cfbs add",
      "steps": ["input ./input.json def.json"],
      "input": [
        {
          "type": "list",
          "namespace": "default",
          "bundle": "def",
          "variable": "acl",
          "label": "Allowed hosts",
          "subtype": {
            "type": "string",
            "label": "IP / subnet",
            "question": "IP / subnet to allow"
          },
          "while": "Do you want to specify more IPs / subnets?"
        }
      ]
    }
  ]
}
