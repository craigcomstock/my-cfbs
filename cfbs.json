{
  "name": "Example project",
  "description": "Example description",
  "type": "policy-set",
  "git": true,
  "build": [
    {
      "name": "masterfiles",
      "description": "Official CFEngine Masterfiles Policy Framework (MPF) (3.24.x)",
      "url": "https://github.com/cfengine/masterfiles",
      "commit": "7e2fb2112a50fe0e3fe52241f1ac1414950b34e3",
      "added_by": "cfbs add",
      "steps": ["run ./prepare.sh -y", "copy ./ ./"]
    },
    {
      "name": "./mpf-overlay/",
      "description": "Local subdirectory added using cfbs command line",
      "tags": ["local"],
      "added_by": "cfbs add",
      "steps": ["directory ./ ./"]
    },
    {
      "name": "./un24-settings.json",
      "description": "Local augments file added using cfbs command line",
      "tags": ["local"],
      "added_by": "cfbs add",
      "steps": ["json ./un24-settings.json def.json"]
    },
    {
      "name": "./demo.json",
      "description": "Local augments file added using cfbs command line",
      "tags": ["local"],
      "added_by": "cfbs add",
      "steps": ["json ./demo.json def.json"]
    },
    {
      "name": "client-initiated-reporting",
      "description": "Enables client initiated reporting and disable pull collection.",
      "tags": ["reporting", "experimental"],
      "repo": "https://github.com/cfengine/modules",
      "by": "https://github.com/cfengine",
      "version": "0.1.1",
      "commit": "c3b7329b240cf7ad062a0a64ee8b607af2cb912a",
      "subdirectory": "reporting/client-initiated-reporting",
      "added_by": "cfbs add",
      "steps": ["json def.json def.json"]
    },
    {
      "name": "./masterfiles-stage-enable.json",
      "description": "Local augments file added using cfbs command line",
      "tags": ["local"],
      "added_by": "cfbs add",
      "steps": ["json ./masterfiles-stage-enable.json def.json"]
    },
    {
      "name": "./policy-not-kept.cf",
      "description": "Local policy file added using cfbs command line",
      "tags": ["local"],
      "added_by": "cfbs add",
      "steps": [
        "copy ./policy-not-kept.cf services/cfbs/policy-not-kept.cf",
        "policy_files services/cfbs/policy-not-kept.cf",
        "bundles policy_not_kept"
      ]
    },
    {
      "name": "./chrony.cf",
      "description": "Local policy file added using cfbs command line",
      "tags": ["local"],
      "added_by": "cfbs add",
      "steps": [
        "copy ./chrony.cf services/cfbs/chrony.cf",
        "policy_files services/cfbs/chrony.cf",
        "bundles chrony"
      ]
    },
    {
      "name": "windows-capability",
      "description": "Manage and inventory Windows Capabilities.",
      "tags": ["supported", "windows", "inventory", "management"],
      "repo": "https://github.com/cfengine/modules",
      "by": "https://github.com/craigcomstock",
      "version": "1.0.0",
      "commit": "9daca3b9e366daeeb53e872685a358c78823f29d",
      "subdirectory": "management/windows-capability",
      "added_by": "cfbs add",
      "steps": [
        "directory ./ services/cfbs/windows-capability/",
        "policy_files services/cfbs/windows-capability/",
        "bundles windows_capability"
      ]
    },
    {
      "name": "./changes_test.cf",
      "description": "Local policy file added using cfbs command line",
      "tags": ["local"],
      "added_by": "cfbs add",
      "steps": [
        "copy ./changes_test.cf services/cfbs/changes_test.cf",
        "policy_files services/cfbs/changes_test.cf",
        "bundles changes_test"
      ]
    }
  ]
}
