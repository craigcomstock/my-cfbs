body file control
{
  namespace => "inventory_sshd_version";
}

bundle agent inventory_sshd_version
{
  classes:
    linux::
      "sshd_binary_works"
        if => returnszero("${lib_sshd_config._sshd_path} -td 1>/dev/null 2>&1", "useshell");

  vars:
    sshd_binary_works::
      "sshd_version" string => nth(
        string_split(execresult("${lib_sshd_config._sshd_path} -td", "useshell"), " ", 3),
        1),
      meta => {"inventory", "attribute_name=OpenSSH version"};

  reports:
    DEBUG|DEBUG_INVENTORY_OPENSSH_VERSION::
      "OpenSSH version: $(sshd_version)";
}
