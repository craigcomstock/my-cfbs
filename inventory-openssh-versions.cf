body file control
{
  namespace => "inventory_sshd_version";
}

bundle agent inventory_sshd_version
{
  vars:
    !windows::
      "_sshd_path" string => "usr/sbin/sshd";
  classes:
    linux::
      "sshd_binary_works"
        if => returnszero("${_sshd_path} -td 1>/dev/null 2>&1", "useshell");

  vars:
    sshd_binary_works::
      "sshd_output" string =>
nth(
splitstring(
execresult("${_sshd_path} -td", "useshell"),
"\\n", 2)
,0);

  classes:
    sshd_binary_works::
    "found_version" expression => regextract(
"^.*OpenSSH_([0-9\.]+).*",
"${sshd_output}",
"captures"
);

  vars:
    found_sshd_version::
      "sshd_version_inventory" string => "${captures[1]}",
        meta => {"inventory", "attribute_name=OpenSSH version"};

  reports:
    DEBUG|DEBUG_INVENTORY_OPENSSH_VERSION::
      "OpenSSH version: $(sshd_version)";
}
