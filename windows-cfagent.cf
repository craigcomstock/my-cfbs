# docker save and docker load to make things "faster" for demo :)
# maybe try to make an appx package as well!? cfengine-agent that is.
bundle agent windows_cfagent
{
  docker:
    windows::
      "test-cfengine"
        command => "msiexec /i https://cfengine-package-repos.s3.amazonaws.com/enterprise/Enterprise-3.24.0/agent/windows_x86_64/cfengine-nova-3.24.0-1-x86_64.msi",
        image => "mcr.microsoft.com/windows/servercore:10.0.19042.1889",
        state => "running"; # created, running, exited, paused, dead
}

# PS C:\Users\jenkins> & 'C:\Program Files\Docker\Docker\DockerCli.exe' -SwitchWindowsEngine
# PS C:\Users\jenkins> docker build -f .\Dockerfile .
