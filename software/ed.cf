bundle agent ed
{
  methods:
    data:ed_installed::
      "ed_installed";
}

bundle agent ed_installed
{
  vars:
    windows::
      "version" string => "1.2";
      "filename" string => "ed-${version}-setup.exe";
#      "url" string => "http://downloads.sourceforge.net/gnuwin32/${filename}";
"url" string => "https://downloads.sourceforge.net/project/gnuwin32/ed/1.2/ed-1.2-setup.exe?ts=gAAAAABmz0KwPNubuFSmC3nFUEGmBGATJwHpixqTE78QuAo8Q0_z3I1RZgugUqjlFUcfBQUc12B9YsacOXch5Xl8vmWAuHAHwA%3D%3D&r=https%3A%2F%2Fsourceforge.net%2Fprojects%2Fgnuwin32%2Ffiles%2Fed%2F1.2%2Fed-1.2-setup.exe%2Fdownload%3Fuse_mirror%3Dphoenixnap";
      "exe_path" string => "${sys.windir}${const.dirsep}Temp${const.dirsep}${filename}"; # TODO: maybe add a sys.tmpdir?
      "md5sum" string => "ef6d4e0f62847f7de9cb4edbabb9e9d1";

  commands:
    windows::
      "iwr ${url} -OutFile ${exe_path}"
        contain => powershell,
        classes => if_ok("download_ok");
# https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.core/about/about_comparison_operators?view=powershell-7.4
    windows.download_ok::
      `powershell -command "if((Get-FileHash ${exe_path} -Algorithm MD5 | select-object -expandproperty hash) -eq '${md5sum}'){exit 0}else{exit 1}"`
        contain => powershell,
        classes => cmd_repair(1, "md5sum_ok");

  packages:
    !windows::
      "ed" policy => "present";
    windows.md5sum_ok::
      "${exe_path}"
        policy => "present";
}
