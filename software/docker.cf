# TODO switch to windows engine
# download image
# docker pull mcr.microsoft.com/windows/servercore:10.0.19042.1889
# run that, install cfengine, bootstrap to hub!
bundle agent docker_desktop
{
  methods:
    data:docker_desktop_installed::
      "docker_desktop_installed";
}

bundle agent docker_desktop_installed
{
  # installing dockerdesktop before dependencies is OK?
  methods:
    windows::
      "windows_docker_desktop_dependencies";

  packages:
    windows::
# CASE MATTERS! ;) Sorry.
      "Docker.DockerDesktop"
        package_method => winget,
        package_policy => "add";
}

# https://docs.docker.com/desktop/install/windows-install/
# use hyper-v, using wsl2 requires a LARGE ubuntu download
bundle agent windows_docker_desktop_dependencies
{
  methods:
    windows::
      "enable-hyperv" usebundle => set_windows_optional_feature_state("Microsoft-Hyper-V", "Enabled");
}
