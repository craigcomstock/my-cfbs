bundle agent winget_installed
{
  methods:
    windows::
      "powershell_execution_policy_set" usebundle => powershell_execution_policy_set("LocalMachine", "Unrestricted"),
        classes => if_ok("execution_policy_ok");

  classes:
    windows::
# sorry, side-effect here, when checking winget I will also accept the source agreements
# TODO make --accept-source-arguments a boolean cfbs input
      "winget_installed" expression => returnszero("winget update --accept-source-agreements | out-null", "powershell");
      "winget_module_installed" expression => returnszero("Get-WinGetPackage | out-null", "powershell");

  commands:
    windows.!winget_installed.execution_policy_ok::
      "powershell.exe -File '${this.promise_dirname}/install-winget.ps1'"
        contain => powershell;
    windows.!winget_module_installed.execution_policy_ok::
      "powershell.exe -File '${this.promise_dirname}/install-winget-powershell-module.ps1'"
        contain => powershell;
}
